# ═══════════════════════════════════════════════════════════════════════════════
# DEVELOPMENT ENVIRONMENT — copy to .env.dev and fill in your values
#
# Used by:  docker compose --env-file .env.dev up --build
#
# All NEXT_PUBLIC_ vars are passed as Docker build args (baked into the JS
# bundle at build time). Server-only vars are injected at container runtime.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Azure AD ─────────────────────────────────────────────────────────────────

AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx          # frontend app reg
AZURE_CLIENT_SECRET=your-dev-client-secret
AZURE_APP_SCOPE=api://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/.default
AZURE_BACKEND_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx  # backend app reg

# ── NEXT_PUBLIC_ (baked into JS bundle at build time) ────────────────────────

NEXT_PUBLIC_AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000
NEXT_PUBLIC_BACKEND_SCOPE=api://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/data.read
# Browser-facing URL (what the browser sees — must be reachable from the user's machine)
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8080

# ── Docker networking ─────────────────────────────────────────────────────────
# Internal URL for server-to-server calls inside Docker (Next.js → Spring Boot).
# Uses the service name defined in docker-compose.yml as the hostname.
# The browser never sees this URL.
BACKEND_INTERNAL_URL=http://backend:8080

# ── Frontend URL (CORS in Spring Boot) ───────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── PostgreSQL (local Docker DB service) ─────────────────────────────────────
# These values must match what the 'db' service in docker-compose.yml uses.
# Leave defaults if you haven't changed them.
POSTGRES_USER=msaluser
POSTGRES_PASSWORD=msalpass
# SPRING_DATASOURCE_URL is set automatically by docker-compose.yml to:
#   jdbc:postgresql://db:5432/msaldb
# Override only if you are connecting to an external database.
# SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/msaldb

# ── DockerHub image names (used by docker-compose.prod.yml) ──────────────────
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest
