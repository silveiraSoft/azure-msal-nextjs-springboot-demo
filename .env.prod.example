# ═══════════════════════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT — copy to .env.prod and fill in your values
#
# Used by:  docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# IMPORTANT:
#   - Never commit .env.prod to git (it contains secrets)
#   - NEXT_PUBLIC_ values point to your public production URLs
#   - NEXT_PUBLIC_REDIRECT_URI must match a Redirect URI in Azure portal
# ═══════════════════════════════════════════════════════════════════════════════

# ── Azure AD ─────────────────────────────────────────────────────────────────

AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your-production-client-secret
AZURE_APP_SCOPE=api://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/.default
AZURE_BACKEND_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── NEXT_PUBLIC_ (baked into JS bundle at build time) ────────────────────────
# Point to your production public URLs

NEXT_PUBLIC_AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Must exactly match a Redirect URI registered in Azure portal
NEXT_PUBLIC_REDIRECT_URI=https://your-app.vercel.app
NEXT_PUBLIC_BACKEND_SCOPE=api://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/data.read
# Public URL of the backend (reachable from the user's browser)
NEXT_PUBLIC_BACKEND_API_URL=https://your-backend.onrender.com

# ── Docker networking ─────────────────────────────────────────────────────────
# Internal container-to-container URL (Next.js server → Spring Boot)
BACKEND_INTERNAL_URL=http://backend:8080

# ── Frontend URL (CORS in Spring Boot) ───────────────────────────────────────
FRONTEND_URL=https://your-app.vercel.app

# ── Neon PostgreSQL (free serverless DB — https://neon.tech) ─────────────────
# 1. Sign up at neon.tech → create a project → copy the connection string
# 2. Format: postgres://user:password@host.neon.tech/dbname?sslmode=require
# 3. Convert to JDBC format for Spring Boot:
#    jdbc:postgresql://host.neon.tech/dbname?sslmode=require&user=USER&password=PASS
#    OR use the separate username/password fields below:
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=your-neon-username
SPRING_DATASOURCE_PASSWORD=your-neon-password

# ── DockerHub image names ─────────────────────────────────────────────────────
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=1.0.0
