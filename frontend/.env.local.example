# ============================================================
# NEXT.JS + MSAL ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values.
# ============================================================

# ------------------------------------------------------------
# NEXT_PUBLIC_ variables are embedded into the browser bundle.
# They are used by @azure/msal-browser for the USER LOGIN flow.
# NEVER put secrets in NEXT_PUBLIC_ variables.
# ------------------------------------------------------------

# Your Azure AD tenant ID (find it in Azure Portal → Azure Active Directory → Overview)
NEXT_PUBLIC_AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Client ID of the FRONTEND app registration
# (Azure Portal → App registrations → <your frontend app> → Application (client) ID)
NEXT_PUBLIC_AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Where Azure AD redirects after login. Must match a Redirect URI in the app registration.
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000

# The API scope exposed by the BACKEND app registration.
# Format: api://<BACKEND_CLIENT_ID>/<scope_name>
# Used in loginRequest.scopes so the user token includes this scope.
NEXT_PUBLIC_BACKEND_SCOPE=api://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/data.read

# URL of the Spring Boot API
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8080

# ------------------------------------------------------------
# Server-side only (no NEXT_PUBLIC_ prefix).
# Used by @azure/msal-node for the APPLICATION TOKEN flow
# (client credentials / machine-to-machine).
# These variables are NEVER sent to the browser.
# ------------------------------------------------------------

# Same tenant ID as above (server-side reference)
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Client ID of the app registration used to obtain app tokens.
# This can be the same frontend app registration (add a client secret to it)
# or a separate daemon/service app registration.
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Client secret for the above app registration.
# (Azure Portal → App registrations → <app> → Certificates & secrets → New client secret)
AZURE_CLIENT_SECRET=your-client-secret-value

# The scope to request when obtaining an application token.
# Use <BACKEND_CLIENT_ID>/.default to include all app roles defined on the backend.
AZURE_APP_SCOPE=api://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/.default
